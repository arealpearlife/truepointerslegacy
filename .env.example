# Shopify is authoritative for products, prices, inventory, and checkout.
# Leave token values empty to use tokenless Storefront API access.
# Never put an Admin API token in this file or in a NEXT_PUBLIC variable.

# Customer-facing Next.js origin. Local development still runs at http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.legacybytp.com

# Storefront API host. Keep the *.myshopify.com shop hostname unless Shopify issues a custom API domain.
SHOPIFY_STORE_DOMAIN=rcvvv5-tk.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-10
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
